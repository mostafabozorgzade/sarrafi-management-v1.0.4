generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum OrderType {
  IR_TO_PK
  PK_TO_IR
  BUY_PKR
  SELL_PKR
}

enum OrderStatus {
  DRAFT
  REGISTERED
  TOMAN_RECEIVED
  AWAITING_PKR_TRANSFER
  PKR_TRANSFERRED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  HAWALA
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  CASH
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  address       String?
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cashRegisters CashRegister[]
  currencies    Currency[]
  currencyRates CurrencyRate[]
  customers     Customer[]
  expenses      Expense[]
  orders        Order[]
  transactions  Transaction[]
  users         User[]

  @@map("tenants")
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String?         @db.Uuid
  mobile       String          @unique
  password     String
  firstName    String
  lastName     String
  role         Role            @default(CASHIER)
  isActive     Boolean         @default(true)
  lastLogin    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  expenses     Expense[]
  orders       Order[]
  rateChanges  CurrencyRate[]
  transactions Transaction[]
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([mobile])
  @@map("users")
}

model Currency {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  code         String
  name         String
  symbol       String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currencyRates CurrencyRate[]
  transactions Transaction[]
  orders       Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("currencies")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String
  phone        String
  pakAccount   String?
  debt         BigInt        @default(0)
  totalBuy     BigInt        @default(0)
  totalSell    BigInt        @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  transactions Transaction[]

  @@index([tenantId])
  @@map("customers")
}

model Order {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  customerId       String         @db.Uuid
  userId           String         @db.Uuid
  currencyId       String         @db.Uuid
  orderType        OrderType
  status           OrderStatus    @default(DRAFT)

  amount           BigInt
  rate             BigInt
  totalToman       BigInt
  calculatedPkr    BigInt?
  fee              BigInt         @default(0)
  profit           BigInt?

  recipientName    String?
  recipientAccount String?
  recipientMethod  DeliveryMethod?
  destinationCard  String?
  destinationSheba String?

  description      String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  currency         Currency       @relation(fields: [currencyId], references: [id])
  customer         Customer       @relation(fields: [customerId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id])
  transaction      Transaction?

  @@index([tenantId])
  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@map("orders")
}

model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  customerId  String   @db.Uuid
  orderId     String?  @db.Uuid @unique
  type        String
  currencyId  String   @db.Uuid
  amount      BigInt
  rate        BigInt
  totalToman  BigInt
  profit      BigInt
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  currency    Currency @relation(fields: [currencyId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([currencyId])
  @@index([createdAt])
  @@map("transactions")
}

model CashRegister {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  name      String
  type      String
  balance   BigInt      @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  entries   CashEntry[]
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cash_registers")
}

model CashEntry {
  id          String       @id @default(uuid()) @db.Uuid
  registerId  String       @db.Uuid
  type        String
  amount      BigInt
  description String?
  createdAt   DateTime     @default(now())
  register    CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId])
  @@map("cash_entries")
}

model CurrencyRate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  currencyId  String   @db.Uuid
  buyRate     BigInt
  sellRate    BigInt
  changedById String   @db.Uuid
  createdAt   DateTime @default(now())
  changedBy   User     @relation(fields: [changedById], references: [id])
  currency    Currency @relation(fields: [currencyId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyId])
  @@index([tenantId])
  @@index([currencyId])
  @@map("currency_rates")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  category    String
  amount      BigInt
  description String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("expenses")
}
